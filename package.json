{
  "name": "react-spectrum-analyzer",
  "version": "0.1.0",
  "description": "Responsive, zero-dependency React spectrum analyzer: averaging queue, max/min hold, zoom, draggable level line, bandwidth ruler and frequency labels.",
  "license": "MIT",
  "author": "miladyazdani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miladyazdani/react-spectrum-analyzer.git"
  },
  "homepage": "https://github.com/miladyazdani/react-spectrum-analyzer#readme",
  "bugs": {
    "url": "https://github.com/miladyazdani/react-spectrum-analyzer/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "spectrum",
    "spectrum-analyzer",
    "fft",
    "rf",
    "sdr",
    "canvas",
    "chart"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib",
    "test": "vitest run",
    "lint": "eslint src demo",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@vitejs/plugin-react": "^4.5.1",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}